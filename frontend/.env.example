# Скопируйте в .env.local и поменяйте под окружение.

# true — работать на встроенных моках (демо), false — ходить в реальный бэкенд
VITE_USE_MOCKS=true
# Базовый адрес API бэкенда (контракты — src/api/types.ts, README.md)
VITE_API_BASE_URL=/api
VITE_API_TIMEOUT_MS=15000

# Печать: mock — имитация; browser — window.print() (Chromium --kiosk-printing); bridge — локальный Device Bridge
VITE_PRINT_MODE=mock
# Адрес локального агента устройств (датчик присутствия, термопринтер, A4)
VITE_DEVICE_BRIDGE_URL=ws://127.0.0.1:8787

# Таймаут бездействия (сек) и за сколько секунд до сброса показывать предупреждение
VITE_IDLE_TIMEOUT_SEC=75
VITE_IDLE_WARNING_SEC=15

# Озвучивать ответы консультанта (API /ai/tts, затем синтез речи браузера)
VITE_TTS_ENABLED=false
# Язык по умолчанию: kk | ru | en
VITE_DEFAULT_LANG=ru
VITE_KIOSK_ID=kiosk-01

# Qwen AI only; billing/documents/content still follow VITE_USE_MOCKS
VITE_QWEN_ENABLED=false
VITE_QWEN_API_URL=/qwen-api
